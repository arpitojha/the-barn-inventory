rules_version = '2';

// Open by design: this app has no login, and the venue chose a single
// shared inventory over per-device accounts. Only the /barn/** path is
// exposed — nothing else in the project is reachable through these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /barn/{document=**} {
      allow read, write: if true;
    }
  }
}
